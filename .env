OLLAMA_URL=http://localhost:11434
LLM_MODEL=gpt-oss:20b-cloud
APP_ENV=development

# PostgreSQL — local dev (Docker)
DB_PASSWORD=1976
DATABASE_URL=postgresql://postgres:1976@localhost:5432/political

# Firebase token verification (required in production, optional in dev)
# Option A — paste the entire service account JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option B — path to the downloaded JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json

# ── Service toggles ───────────────────────────────────────────────────────
# Each service in services/run.py reads its ENABLE_<NAME> flag. Set to
# false to skip booting that service; the gateway then returns 503 with a
# clear reason for any request to that service's prefix.
ENABLE_AGENT=true
ENABLE_AVATAR_SERVICE=true
ENABLE_GPU_AVATAR=true        # mock LivePortrait — flip to true when a GPU box is ready
ENABLE_TAVUS=true            # cloud replica — also needs TAVUS_API_KEY below
ENABLE_STT=true              # Speech-to-Text (faster-whisper) — port 8004

# STT language allow-list. Comma-separated ISO codes. Whisper auto-detects
# only across these; anything else returns a clear "language not supported"
# error instead of silently mistranscribing. Add codes as you expand:
# e.g. STT_LANGUAGES=en,ta,hi → opens up Hindi too.
STT_LANGUAGES=en,ta

# ── Avatar pipeline (self-hosted) ─────────────────────────────────────────
# Gateway entry port — `python services/run.py` exposes this and spawns
# enabled backends internally.
GATEWAY_PORT=9000

# Avatar-service URL the agent uses internally. Leave as localhost for
# single-host dev; point at a remote box (e.g. GPU server) if you split
# the stack later.
AVATAR_SERVICE_URL=http://localhost:8002

# Default edge-tts voice for the avatar-service. Tamil / Hindi messages
# auto-route to language-matched voices regardless of this setting.
# AVATAR_TTS_VOICE=en-IN-NeerjaNeural

# gpu-avatar URL — used by the agent / browser to reach the GPU box that
# runs LivePortrait + audio2motion. Defaults to localhost (the mock); point
# at a remote GPU host once you provision real hardware.
# GPU_AVATAR_URL=http://localhost:8003

# ── Tavus (cloud photoreal replica) ───────────────────────────────────────
# Sign up at https://tavus.io → Developer → API keys. The tavus-service
# uses this to create replicas + open Conversational Video Interface
# sessions. Service is skipped on startup if this is unset or empty.
TAVUS_API_KEY=34b8551a204f40bbb7b361fc7a210ac8
# TAVUS_API_BASE=https://tavusapi.com
# Public webhook URL Tavus will call for custom-LLM mode. In local dev,
# run `ngrok http 9000` and put the public ngrok URL here.
# TAVUS_WEBHOOK_BASE=https://your-ngrok-or-prod-domain

# Legacy edge-tts voice for the non-avatar /chat audio fallback. Optional.
# TTS_VOICE=en-IN-NeerjaNeural

# ── Voice Cloning (Fish Audio) ────────────────────────────────────────────────
# Set TTS_ENGINE=fish to use Vijay's cloned voice via Fish Audio cloud.
# Set TTS_ENGINE=edge to use generic Microsoft Neural voices (default).
# Steps: 1) Sign up at fish.audio  2) Upload reference audio → get model ID
#         3) Create API key  4) Fill in below and set TTS_ENGINE=fish
TTS_ENGINE=fish
FISH_AUDIO_URL=https://api.fish.audio
FISH_AUDIO_API_KEY=fe53dcf1270a4a35a82a9e43aeec0d36
FISH_AUDIO_VOICE_ID=a9710ffd6af24fdea8ff1c8441043c42

