# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option B — path to the downloaded JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json
