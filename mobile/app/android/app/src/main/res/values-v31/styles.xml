<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) SplashScreen API ignores android:windowBackground for the
         system-drawn splash and defaults to white unless windowSplashScreenBackground is
         set explicitly — this is what caused the white flash on startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
